# Copy this file to .env and fill in ONE key.  Never commit .env to git!

# Which provider to use: openai | anthropic | mock (mock = no key, offline)
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...your-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Optional overrides (defaults are cheap, fast models)
# OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_EMBED_MODEL=text-embedding-3-small
# RAG_RETRIEVER=tfidf
